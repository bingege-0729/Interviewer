# 复制为 .env 后按实际环境填写（.env 已在 .gitignore 中排除）

# ---------- Nacos ----------
NACOS_SERVER=127.0.0.1:8849
NACOS_USER=nacos
NACOS_PASSWORD=

# ---------- MySQL ----------
MYSQL_SERVER=127.0.0.1:3306
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------- Redis ----------
REDIS_SERVER=127.0.0.1
REDIS_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_SERVER=127.0.0.1
RABBITMQ_USER=root
RABBITMQ_PASSWORD=

# ---------- 大模型（AI 模块必需） ----------
DASHSCOPE_API_KEY=

# ---------- 微信登录（可选：扫码登录） ----------
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_SECRET=

# ---------- 微信支付（可选：下单支付） ----------
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_API_V3_KEY=

# ---------- 阿里云 OSS（可选：头像、题图存储） ----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 短信（可选：验证码发送） ----------
SMS_APP_CODE=
