# 复制为 .env 后按实际环境填写（.env 已在 .gitignore 中排除）

# ---------- Nacos ----------
NACOS_SERVER=127.0.0.1:8849
NACOS_USER=nacos
NACOS_PASSWORD=

# ---------- MySQL ----------
MYSQL_SERVER=127.0.0.1:3306
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------- Redis ----------
REDIS_SERVER=127.0.0.1
REDIS_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_SERVER=127.0.0.1
RABBITMQ_USER=root
RABBITMQ_PASSWORD=

# ---------- 阿里云 OSS（可选：头像、题图存储） ----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 短信（可选：验证码发送） ----------
SMS_APP_CODE=

# ---------- 大模型（AI 模块必需） ----------
# 目前 DashScope Key 仍写在 ai-service 的配置文件中，建议迁移为环境变量引用
DASHSCOPE_API_KEY=
